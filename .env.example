# Firebase Web App Configuration (Free Spark Plan works with Firebase AI Logic)
# Enable "AI Logic -> Gemini Developer API" in Firebase Console for this project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_CLOUD_MODEL=gemini-4-hydrogen
# Optional: Firebase App Check (recommended for Firebase AI Logic; debug token accepted for hackathon demos)
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
